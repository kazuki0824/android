<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Additional projects for VyOS + Android TV guest builds -->
  <remote name="maleicacid" fetch="https://github.com/kazuki0824" />
  <remote name="microg" fetch="https://github.com/microg" />

  <!-- Product overlays / build glue -->
  <project name="android_device_maleicacid_androidtv"
           path="device/maleicacid/androidtv"
           remote="maleicacid"
           revision="main" />

  <!-- microG (GApps-equivalent) built from repo-synced source under Soong orchestration -->
  <project name="android_vendor_maleicacid_microg"
           path="vendor/maleicacid/microg"
           remote="maleicacid"
           revision="main" />

  <!-- Upstream sources fetched by repo (requirement 10*) -->
  <project name="GmsCore"
           path="vendor/maleicacid/microg/upstream/GmsCore"
           remote="microg"
           revision="master" />

  <!-- virtio targets required by virtio_x86_64_tv base -->
  <project name="LineageOS/android_device_virt_virtio-common"
           path="device/virt/virtio-common"
           remote="github"
           revision="refs/heads/lineage-21" />
  <project name="LineageOS/android_device_virt_virtio_x86_64"
           path="device/virt/virtio_x86_64"
           remote="github"
           revision="refs/heads/lineage-21" />
  <project name="LineageOS/android_device_virt_virtio_x86_64_tv"
           path="device/virt/virtio_x86_64_tv"
           remote="github"
           revision="refs/heads/lineage-21" />
  <project name="LineageOS/android_kernel_virt_virtio"
           path="kernel/virt/virtio"
           remote="github"
           revision="refs/heads/lineage-21" />

  <!-- virt-common (required by virtio-common) -->
  <project name="LineageOS/android_device_virt_virt-common"
           path="device/virt/virt-common"
           remote="github"
           revision="refs/heads/lineage-21" />
  
  <!-- bootmgr prebuilts required for virt-common GRUB build -->
  <project name="LineageOS/android_prebuilts_bootmgr"
           path="prebuilts/bootmgr"
           remote="github"
           revision="refs/heads/lineage-21" />
  <project name="platform/external/u-boot"
           path="external/u-boot"
           revision="main" />
</manifest>
